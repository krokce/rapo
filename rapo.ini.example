# Example Rapo configuration.
#
# Copy to rapo.ini in the application folder (next to the rapo package):
#     cp rapo.ini.example rapo.ini
# or place it anywhere and point the RAPO_CONFIG environment variable to it.
# rapo.ini holds secrets and is gitignored - never commit it.
#
# Values are normalized on load: True/False -> bool, digits -> int/float,
# empty or None -> None.

[SCHEDULER]
# Run the scheduler inside this web server (rapo-server). Set to False for an
# API-only server. Only one server schedules at a time, the others stand by.
# It can also be stopped and started from the UI (Scheduler page).
enabled=True
# Number of controls executed in parallel (scheduled and manual runs).
control_parallelism=10
# Seconds between scheduler refreshes of the control configuration.
refresh_interval=300
# Seconds between maintenance runs (retention cleanup, stale checkpoints).
maintenance_interval=86400
# Seconds between scheduler status reports to the database.
database_report_interval=600
# Days scheduler events (fires, manual runs, missed fires) are kept.
event_retention_days=90
# Hours back that fires missed while no scheduler was running are recorded.
missed_window_hours=24
# Seconds without heartbeat after which a standby server takes over.
lease_timeout=60
# Name shown in the web UI, e.g. AUT Dev / AUT Prod.
instance_name=AUT Dev

[DATABASE]
vendor_name=oracle
driver_name=cx_oracle
host=localhost
port=1521
# Use either service_name or sid.
service_name=RAAUT
# Or the SID instead of service_name, or a full address in path (e.g. a TNS
# alias) instead of host, port and service.
#sid=
#path=
username=rapo_user
password=change_me
max_identifier_length=128
max_overflow=5
pool_pre_ping=True
pool_size=20
pool_recycle=3600
pool_timeout=30
# Folder of the Oracle Instant Client; empty: found on the library path.
#client_path=

[ALGORITHM]
# Global defaults for the reconciliation algorithm.
fuzzy_optimization=True
normalization_type=default
discrepancy_matching=True

[LOGGING]
# Folder of log files, relative paths start at the folder of this file.
# Holds rapo-server_YYYYMMDD.log (server, one per day) and
# controls/<control_id>/<process_id>.log (one per control run).
directory=logs
# Days server logs and logs of deleted controls are kept (empty = forever).
# Run logs are kept as long as their control's days_retention.
retention_days=30
console=True
file=True
info=True
debug=True
error=True
warning=True
critical=True
# Record template, file size (bytes) before a new log file, traceback depth
# and the errors after which the logger stops the process (pepperoni).
#format={isodate}\t{thread}\t{rectype}\t{message}\n
#maxsize=10485760
#maxlevel=2
#maxerrors=

[API]
# Address and port of rapo-server (defaults: 127.0.0.1 / 8080).
host=0.0.0.0
port=7005
# Bearer token required by every /api request. Generate a strong one, e.g.:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# A digits-only token is read as a number, so prefer a mixed one.
token=change_me
# Serve the Swagger UI at /api/docs and the schema at /api/openapi.json.
# Neither can carry the Bearer token, so they describe the whole API to
# anyone able to reach the port. Off unless set.
docs=False

[EMAIL]
# Sending of control results per email, configured per control in the
# editor's Email tab. Off unless set: no email leaves this instance.
enabled=False
# SMTP server. security is starttls (default), ssl or none.
host=smtp.example.com
port=587
security=starttls
# Login, when the server requires one.
user=
password=
# Sender address and display name, and an optional Reply-To.
sender=rapo@example.com
sender_name=RAPO
reply_to=
# Seconds to wait for the SMTP server.
timeout=30
# Upper bounds of an attachment. Above either one the email is sent
# without the file, with a note. A control's own limit can only be lower.
max_attachment_rows=100000
max_attachment_mb=20

[ANALYSIS]
# Data analysis of a run's records, opened from the Results page. Each open
# analysis page holds a sample of the records in a process of its own.
# Rows loaded first, and added by each Extend.
initial_rows=50000
extend_rows=50000
# Upper bound of a sample.
max_rows=1000000
# Samples open at once on this server (an analysis page holds one, two while
# it compares); more are refused until one closes.
max_sessions=4
# An analysis not used for this long is closed and its memory freed.
idle_minutes=15
# A sample stops growing when its process uses more memory than this.
max_memory_mb=2048
# Discrepancy analysis (what sets a run's discrepancies apart from its normal
# records) first takes a quick look at about this many records of each
# dataset, a block sample of the table (or its first records where Oracle can
# not sample), shown at once as preliminary results.
discrepancy_quick_rows=100000
# Then it refines them: one scan counting every record up to this many, a
# random sample of about this size of a larger dataset.
discrepancy_exact_rows=1000000
# Degree of the parallel hint of the refining scans; 0 for none.
discrepancy_parallel=4
# An analysis running longer is stopped (its preliminary results are kept).
# One runs at a time on a server.
discrepancy_timeout_minutes=20

[KPI]
# Calculate KPIs (the control editor's KPIs tab, a run's menu) runs a KPI or
# alarm statement for a past run without storing it. Seconds before one
# statement is stopped.
calculate_timeout=120

[VIEWS]
# The control editor offers to edit the SQL (the query) of a datasource that
# is a view of the own schema: check it on a scratch view, preview its first
# rows and replace the view (CREATE OR REPLACE VIEW, refused while the new SQL
# is invalid). The previous DDL is written to the server log. False hides it.
edit=True
# A preview runs the edited SQL read only, fetching at most preview_max_rows
# rows and stopped after preview_timeout seconds.
preview_max_rows=1000
preview_timeout=30

[DATASOURCES]
# The Datasources page edits the PDI Core datasources (PDI_CORE_DS_CONFIG and
# PDI_CORE_DS_TABLES), shown where the database user can read them, in its own
# schema or through synonyms. The input directories are read from this
# server's file system, so they must be local or mounted as PDI Core sees them.
# Seconds between counts of the incoming files of the active datasources,
# done only while the web UI is open, by a small child process of the server
# (so a slow network file system never holds up the web API), each directory
# read once however many datasources share it.
scan_interval=60
# Files read per directory at most, and seconds one count may take; what is
# left out is counted first next time.
scan_max_entries=200000
scan_budget_seconds=20
# Files listed at most by the file dialogs, and seconds a listing may read
# before it is shown cut.
list_max_files=10000
list_budget_seconds=10
# The clean-up list shows files matching INPUT_CLEAN_FILES_MASK below this
# size; PDI Core itself deletes only those below 10 bytes.
clean_max_bytes=1024
# Mode (octal) of the directories created from the UI; 2775 lets the group,
# e.g. the Pentaho server's user, write in them.
dir_mode=2775
# An active datasource whose oldest waiting file is older than this is
# flagged Stalled.
stalled_minutes=60
# A lane lock (LOAD_<lane> of PDI_CORE_STATE) older than this is shown on the
# Files page as probably stale.
lock_stale_minutes=30
# Downloads of loaded files from the file log (SUCCESS and ERROR files whose
# archived file is kept). They are read from this server's file system, and
# only within the archive, error or duplicate directory of their datasource.
# Several files are sent as one ZIP; a download is held in the browser's memory
# before it is saved, so it may have at most max_download_mb in all.
file_download=True
max_download_mb=500

[HEALTH]
# The Health tab of Instance details: OS and database metrics of this server,
# sampled in the background and kept in memory, the samples for
# history_minutes and their one-minute aggregates for history_hours (the spans
# offered: 1, 3, 6, 12 and 24 hours); a restart starts them anew. The database
# metrics need SELECT on V_$CON_SYSMETRIC, V_$PARAMETER, V_$SESSION,
# V_$SGAINFO, V_$PGASTAT, DBA_TABLESPACE_USAGE_METRICS and V_$INSTANCE (its
# uptime); a view that can not be read shows No access.
enabled=True
# Seconds between OS samples, database samples and reads of the size of rapo's
# result and temporary tables.
os_interval=10
db_interval=30
footprint_interval=600
history_minutes=60
history_hours=24
# Warning and critical levels (a value at or above them), which color the
# tiles and put a dot on the header button. Rules: cpu (average of the last 3
# samples), memory, disk, db_cpu, db_memory (PGA of pga_aggregate_limit) and
# storage in %, locks (blocked sessions), locks_wait (seconds), close_wait (TCP
# connections of the host in CLOSE_WAIT); defaults below.
#cpu_warn=80
#cpu_crit=95
#memory_warn=85
#memory_crit=95
#disk_warn=85
#disk_crit=95
#db_cpu_warn=80
#db_cpu_crit=95
#db_memory_warn=85
#db_memory_crit=95
#storage_warn=85
#storage_crit=95
#locks_warn=1
#locks_crit=
#locks_wait_warn=
#locks_wait_crit=60
#close_wait_warn=50
#close_wait_crit=
